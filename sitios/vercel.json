{
  "git": {
    "deploymentEnabled": {
      "admin-drafts": false
    }
  },
  "rewrites": [
    {
      "source": "/editor",
      "destination": "/admin/index.html"
    },
    {
      "source": "/editor/",
      "destination": "/admin/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/feed/",
      "permanent": false
    }
  ]
}
