{
  "git": {
    "deploymentEnabled": {
      "admin-drafts": false
    }
  },
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- .",
  "rewrites": [
    {
      "source": "/editor",
      "destination": "/admin/index.html"
    },
    {
      "source": "/editor/",
      "destination": "/admin/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/feed/",
      "permanent": false
    }
  ]
}
