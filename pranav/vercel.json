{
  "git": {
    "deploymentEnabled": {
      "admin-drafts": false
    }
  },
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "ignoreCommand": "[ -f ../scripts/vercel-ignore.sh ] && sh ../scripts/vercel-ignore.sh || exit 1"
}
